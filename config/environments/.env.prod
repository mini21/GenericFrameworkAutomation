# PROD environment configuration
# Non-secret defaults only. Real credentials/DB connections are supplied via
# CI secrets or a local, gitignored .env.local override — never committed here.
# NOTE: Running automated tests against prod should be restricted to a
# tightly scoped read-only smoke suite. Enforce this at the CI pipeline level.

BASE_URL=https://www.example.com
API_BASE_URL=https://api.example.com
LOG_LEVEL=warn
