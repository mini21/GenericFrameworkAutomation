# Template for all environment variables the framework understands.
# Copy relevant keys into config/environments/.env.<env>, or override locally
# via a gitignored .env.local (never commit real secrets to .env.<env> files).

# Which environment file to load: dev | qa | staging | prod
ENV=qa

# --- Application under test ---
BASE_URL=
API_BASE_URL=

# --- Logging ---
LOG_LEVEL=info

# --- Authentication (example — populate per project) ---
AUTH_USERNAME=
AUTH_PASSWORD=

# Bearer token attached to every API request when set (src/core/fixtures/api.fixture.ts).
# Leave empty for public/unauthenticated test APIs.
API_AUTH_TOKEN=

# --- Database (optional — the default DbClient is an in-memory example
# implementation that needs none of this; populate once a real driver
# replaces it, see src/core/db/db-client.ts) ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
