{
  "name": "test-automation-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Generic enterprise-grade Test Automation Framework built with Playwright and TypeScript. Supports UI automation, API automation, cross-browser execution, multi-environment configuration, and parallel/tagged test runs.",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "cross-env ENV=qa playwright test",
    "test:ui": "cross-env ENV=qa playwright test tests/ui",
    "test:api": "cross-env ENV=qa playwright test tests/api",
    "test:smoke": "cross-env ENV=qa playwright test --grep @smoke",
    "test:regression": "cross-env ENV=qa playwright test --grep @regression",
    "test:headed": "cross-env ENV=qa playwright test --headed",
    "test:debug": "cross-env ENV=qa playwright test --debug",
    "test:dev": "cross-env ENV=dev playwright test",
    "test:staging": "cross-env ENV=staging playwright test",
    "test:prod": "cross-env ENV=prod playwright test",
    "test:locator": "cross-env ENV=qa playwright test tests/locator",
    "coverage:report": "cross-env ENV=qa playwright test --project=coverage",
    "gap:build": "tsc -p tsconfig.cli.json && node -e \"require('fs').cpSync('applications/hrms/server/public','dist/applications/hrms/server/public',{recursive:true}); require('fs').cpSync('applications/adminpanel/server/public','dist/applications/adminpanel/server/public',{recursive:true}); require('fs').cpSync('applications/storefront/server/public','dist/applications/storefront/server/public',{recursive:true}); require('fs').cpSync('applications/library/server/public','dist/applications/library/server/public',{recursive:true}); require('fs').cpSync('server/ui/public','dist/server/ui/public',{recursive:true})\"",
    "gap": "npm run gap:build --silent && node dist/cli/gap.js",
    "gap:test": "npm run gap:build --silent && node dist/cli/gap-test.js",
    "gap:onboard": "npm run gap:build --silent && node dist/cli/gap-onboard.js",
    "gap:discover": "npm run gap:build --silent && node dist/cli/gap-discover.js",
    "gap:generate": "npm run gap:build --silent && node dist/cli/gap-generate.js",
    "gap:ui": "npm run gap:build --silent && node dist/server/ui/index.js",
    "hrms:start": "npm run gap:build --silent && node dist/applications/hrms/server/app.js",
    "adminpanel:start": "npm run gap:build --silent && node dist/applications/adminpanel/server/app.js",
    "storefront:start": "npm run gap:build --silent && node dist/applications/storefront/server/app.js",
    "library:start": "npm run gap:build --silent && node dist/applications/library/server/app.js",
    "report:show": "playwright show-report reports/html-report",
    "report:allure:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "report:allure:open": "allure open reports/allure-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky || exit 0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@playwright/test": "^1.48.0",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.0",
    "allure-playwright": "^3.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^9.11.0",
    "eslint-config-prettier": "^9.1.0",
    "express": "^5.2.1",
    "husky": "^9.1.6",
    "js-yaml": "^5.2.3",
    "lint-staged": "^15.2.10",
    "playwright": "^1.48.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.7.0",
    "winston": "^3.14.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
