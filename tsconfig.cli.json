{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist"
  },
  "include": [
    "cli/**/*.ts",
    "src/core/config/**/*.ts",
    "src/core/execution/**/*.ts",
    "src/core/intent/**/*.ts",
    "src/core/locator/**/*.ts",
    "src/core/discovery/**/*.ts",
    "src/core/generation/**/*.ts",
    "src/core/coverage/**/*.ts",
    "config/**/*.ts",
    "applications/*/server/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
